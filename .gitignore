# ========================
# DATOS
# ========================
# Ignorar todo el contenido de la carpeta data para no subir el CSV pesado
data/*
!data/.gitkeep

# ========================
# ARTEFACTOS Y RESULTADOS
# ========================
# Ignorar salidas generadas automáticamente (imágenes y predicciones)
outputs/*
!outputs/.gitkeep

# ========================
# ENTORNO VIRTUAL
# ========================
venv/
env/
.venv/

# ========================
# PYTHON Y CACHÉ
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# ========================
# JUPYTER NOTEBOOKS
# ========================
.ipynb_checkpoints/

# ========================
# SISTEMA OPERATIVO Y IDEs
# ========================
.DS_Store
Thumbs.db
.vscode/
.idea/